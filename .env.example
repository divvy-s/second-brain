# ============================================================
# Second Brain — Environment Variables Template
# Copy to .env and fill in your real values.
# ============================================================

# ------------------------------------------------------------
# LLM Providers
# Primary: Gemini (configured in config/user_config.yml)
# Alternative: OpenAI-compatible providers such as OpenAI or OpenRouter
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional / alternative providers (not used by default config)
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ------------------------------------------------------------
# Plugin: Gmail
# Access token is short-lived (~1 hour). For persistent use,
# supply OAuth credentials to enable automatic token refresh.
# Leave GMAIL_ACCESS_TOKEN blank to use mock events.
# ------------------------------------------------------------
GMAIL_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token

# ------------------------------------------------------------
# Plugin: Google Calendar
# Uses the same OAuth credentials as Gmail above.
# Leave CALENDAR_ACCESS_TOKEN blank to use mock events.
# ------------------------------------------------------------
CALENDAR_ACCESS_TOKEN=

# ------------------------------------------------------------
# Plugin: Todoist
# ------------------------------------------------------------
TODOIST_API_KEY=

# ------------------------------------------------------------
# Plugin: Slack
# Also set channel_ids in config/user_config.yml, or use comma-separated IDs here.
# ------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# ------------------------------------------------------------
# Plugin: WhatsApp (Meta Cloud API)
# ------------------------------------------------------------
WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_ID=
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------
# Plugin: Telegram
# TELEGRAM_WEBHOOK_SECRET is used to verify incoming webhook
# requests from Telegram (recommended for production).
# Telegram inbound uses POST /telegram/webhook by default. Do not enable polling
# while a Telegram webhook is registered.
# In development, the API generates a runtime secret if this is blank.
# Open GET /telegram/webhook/setup?public_url=https://<your-ngrok-host>
# to view the exact Telegram setWebhook URL for local setup.
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Memory / Storage
# Safe defaults provided — override only if needed.
# ------------------------------------------------------------
SQLITE_PATH=data/second_brain.sqlite3
CHROMA_PATH=data/chroma
REDIS_URL=redis://localhost:6379/0
SPACY_MODEL=en_core_web_sm
HALF_LIFE_DAYS=30

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# CORS: comma-separated list of allowed frontend origins.
# Default allows the Vite dev server only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API authentication bearer token.
# Production is conservative: protected routes return 503 unless this is set.
# Backend startup fails in ENVIRONMENT=production unless this is set to a strong value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ------------------------------------------------------------
# Frontend
# Set VITE_API_BASE if the API runs on a non-default host/port.
# Create frontend/.env and add these variables there.
# ------------------------------------------------------------
# VITE_API_BASE=http://127.0.0.1:8000
# VITE_API_KEY=the_same_value_as_SECRET_KEY_when_backend_auth_is_enabled
