# ============================================================
# Second Brain — Environment Variables Template
# Copy to .env and fill in your real values.
# ============================================================

# LLM Providers
XAI_API_KEY=your_xai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Plugin: Gmail (leave blank for mock events)
GMAIL_ACCESS_TOKEN=

# Plugin: Google Calendar (leave blank for mock events)
CALENDAR_ACCESS_TOKEN=

# Plugin: Todoist (leave blank for mock events)
TODOIST_API_KEY=

# Plugin: Slack (leave blank for mock events; also set channel_ids in config/user_config.yml)
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Plugin: WhatsApp (leave blank for mock events)
WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_ID=

# Plugin: Telegram (leave blank for mock events)
TELEGRAM_BOT_TOKEN=

# Memory / Storage (these have safe defaults, override if needed)
SQLITE_PATH=data/second_brain.sqlite3
CHROMA_PATH=data/chroma
REDIS_URL=redis://localhost:6379/0
SPACY_MODEL=en_core_web_sm

# API Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Frontend (create frontend/.env and set this if API runs elsewhere)
# VITE_API_BASE=http://127.0.0.1:8000
