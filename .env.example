# Second Brain environment template
# Copy to .env for backend settings. Frontend-only Vite variables belong in frontend/.env.

# LLM providers
GEMINI_API_KEY=  # Primary LLM key; used by intelligence.llm_adapter.LLMAdapter.
OPENROUTER_API_KEY=  # Fallback LLM key; used by intelligence.llm_adapter.LLMAdapter.

# Gmail / Google OAuth
GMAIL_ACCESS_TOKEN=  # Optional Gmail access token; used by scripts.external_cli.gmail_fetch/gmail_action.
GOOGLE_CLIENT_ID=  # Google OAuth client ID for Gmail/Calendar token refresh; used by scripts.external_cli.refresh_google_access_token.
GOOGLE_CLIENT_SECRET=  # Google OAuth client secret for Gmail/Calendar token refresh; used by scripts.external_cli.refresh_google_access_token.
GOOGLE_REFRESH_TOKEN=  # Google OAuth refresh token for Gmail/Calendar token refresh; used by scripts.external_cli.refresh_google_access_token.

# Google Calendar
CALENDAR_ACCESS_TOKEN=  # Optional Calendar access token; used by scripts.external_cli.calendar_fetch/calendar_action.

# Todoist
TODOIST_API_KEY=  # Todoist API token; used by scripts.external_cli.todoist_fetch/todoist_action.

# Slack
SLACK_BOT_TOKEN=  # Slack bot token; used by scripts.external_cli.slack_fetch/slack_action.

# WhatsApp
WHATSAPP_API_KEY=  # Meta WhatsApp Cloud API token; used by scripts.external_cli.whatsapp_fetch/whatsapp_action.
WHATSAPP_BASE_URL=https://graph.facebook.com  # Base URL for WhatsApp event polling; used by scripts.external_cli.whatsapp_fetch.
WHATSAPP_PHONE_NUMBER_ID=  # Meta WhatsApp phone number ID; used by scripts.external_cli.whatsapp_action/health.
WHATSAPP_RECIPIENT_ID=  # Default WhatsApp recipient phone number; used by scripts.external_cli.whatsapp_action.
WHATSAPP_API_VERSION=v22.0  # Meta Graph API version; used by scripts.external_cli.whatsapp_action/health.

# Telegram
TELEGRAM_BOT_TOKEN=  # Telegram bot token; used by scripts.external_cli.telegram_fetch/telegram_action and api.telegram_bot.
TELEGRAM_CHAT_ID=  # Default Telegram chat ID; used by scripts.external_cli.telegram_action.
TELEGRAM_WEBHOOK_SECRET=  # Telegram webhook verification secret; used by api.app telegram webhook auth.

# Structured/context memory and retrieval
DATABASE_URL=  # Optional PostgreSQL DSN; used by api.dependencies.build_services and scripts.init_db.
SQLITE_PATH=data/second_brain.sqlite3  # SQLite file path for local memory; used by api.dependencies.build_services.
CHROMA_PATH=data/chroma  # Vector store directory; used by api.dependencies.build_services and memory.vector_store.VectorStore.
REDIS_URL=redis://localhost:6379/0  # Redis stream URL for the event bus; used by api.dependencies.build_services.
SPACY_MODEL=en_core_web_sm  # spaCy model name for NER; used by api.dependencies.build_services.
HALF_LIFE_DAYS=30  # Context decay half-life in days; used by api.dependencies.build_services and memory.decay.MemoryDecay.

# User and approval behavior
USER_TIMEZONE=UTC  # User timezone for intent classification and scheduling; used by api.dependencies.build_services.
APPROVAL_RISK_THRESHOLD=medium  # Minimum risk level that requires approval; used by api.dependencies.build_services.

# Continuous proactive loop
SECOND_BRAIN_PROACTIVE_LOOP_ENABLED=true  # Enables the background 30-minute orchestration loop; used by api.app and scripts.run_proactive_loop.
SECOND_BRAIN_PROACTIVE_LOOP_INTERVAL_MINUTES=30  # Minutes between proactive cycles; used by api.app and scripts.run_proactive_loop.
SECOND_BRAIN_STALE_APPROVAL_MINUTES=180  # Minutes before pending approvals are treated as ignored; used by api.app and scripts.run_proactive_loop.

# API server
HOST=127.0.0.1  # API bind host; used by scripts.run_api.
PORT=8000  # API bind port; used by scripts.run_api.
DEBUG=false  # Enables uvicorn reload mode when true; used by scripts.run_api.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # Comma-separated CORS origins; used by api.app.
SECRET_KEY=  # Bearer token secret for protected API routes; used by api.app auth middleware.

# Frontend Vite variables
# Put these in frontend/.env, not the backend .env file.
VITE_API_BASE=http://127.0.0.1:8000  # Frontend API base URL; used by frontend/src/api.ts.
VITE_API_TOKEN=  # Frontend bearer token for API calls; used by frontend/src/api.ts.
